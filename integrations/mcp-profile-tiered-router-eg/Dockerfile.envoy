ARG TARGETARCH

FROM debian:bookworm-slim

ARG TARGETARCH
ARG ENVOY_TAG=envoy-0d6e3c60

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /usr/local/bin/envoy \
  "https://github.com/dio/envoy-builder/releases/download/${ENVOY_TAG}/envoy-linux-${TARGETARCH}" \
  && chmod +x /usr/local/bin/envoy

COPY dist/libmcp-profile-gateway.linux-${TARGETARCH}.so /etc/envoy/dynamic-modules/libmcp-profile-gateway.so
COPY dist/libmcp-catalog-router.linux-${TARGETARCH}.so /etc/envoy/dynamic-modules/libmcp-catalog-router.so
COPY dist/libcluster-router.linux-${TARGETARCH}.so /etc/envoy/dynamic-modules/libcluster-router.so

ENTRYPOINT ["/usr/local/bin/envoy"]
