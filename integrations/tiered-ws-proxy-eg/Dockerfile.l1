ARG TARGETARCH

FROM debian:bookworm-slim

ARG TARGETARCH
ARG ENVOY_TAG=envoy-0d6e3c60

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /usr/local/bin/envoy \
  "https://github.com/dio/envoy-builder/releases/download/${ENVOY_TAG}/envoy-linux-${TARGETARCH}" \
  && chmod +x /usr/local/bin/envoy

# L1: shard selection — routes WS upgrade to the right L2 pod at upgrade time.
# No frame inspection after 101; L1 becomes a transparent TCP tunnel.
COPY dist/libcluster-shard-router.linux-${TARGETARCH}.so /etc/envoy/dynamic-modules/libcluster-shard-router.so

ENTRYPOINT ["/usr/local/bin/envoy"]
