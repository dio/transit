ARG TARGETARCH

FROM debian:bookworm-slim

ARG TARGETARCH
ARG ENVOY_TAG=envoy-0d6e3c60

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /usr/local/bin/envoy \
  "https://github.com/dio/envoy-builder/releases/download/${ENVOY_TAG}/envoy-linux-${TARGETARCH}" \
  && chmod +x /usr/local/bin/envoy

# L2: embedded WS proxy server. RegisterWithGroup starts the server on
# :10001. WSPROXY_EGRESS_URL directs upstream dials to the EG-managed egress
# listener on :10002, which handles TLS and credential injection.
COPY dist/libws-proxy.linux-${TARGETARCH}.so /etc/envoy/dynamic-modules/libws-proxy.so

ENTRYPOINT ["/usr/local/bin/envoy"]
