{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1models.response.schema.json",
  "title": "OpenAI-compatible GET /v1/models response",
  "type": "object",
  "required": ["object", "data"],
  "additionalProperties": false,
  "properties": {
    "object": { "type": "string", "const": "list" },
    "data": {
      "type": "array",
      "items": { "$ref": "#/$defs/Model" }
    }
  },
  "$defs": {
    "Model": {
      "type": "object",
      "required": ["id", "object", "owned_by"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "string", "minLength": 1 },
        "object":   { "type": "string", "const": "model" },
        "owned_by": { "type": "string", "minLength": 1 },
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "description":    { "type": "string" },
            "context_length": { "type": "integer", "minimum": 1 },
            "max_tokens":     { "type": "integer", "minimum": 1 },
            "tags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "pricing": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
