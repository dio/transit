#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${ORANGE_LLM_BASE_URL:-http://localhost:8080}"
SHOW_HEADERS="${ORANGE_LLM_SHOW_HEADERS:-0}"
MODEL="dall-e-3"
PROMPT="a photorealistic orange sitting on a wooden table"
SIZE=""
QUALITY=""
N=1
RESPONSE_FORMAT=""
SAVE_DIR=""
OUTPUT_FILE=""
EXTRA_PARAMS=()

usage() {
  cat <<'EOF'
Usage:
  ./images [options] [<prompt>]
  ./images [options] models

Options:
  --model <name>           Model to use (default: dall-e-3)
  --size <WxH>             Image size (e.g. 1024x1024, 1792x1024)
  --quality <q>            Quality: standard|hd (DALL-E 3), low|medium|high (gpt-image-1)
  --n <count>              Number of images to generate (default: 1)
  --response-format <fmt>  url or b64_json (default: provider default)
  --save [<dir>]           Save b64_json images to files (default dir: .)
  --output <file>          Write first image to <file> (b64_json → decoded; url → downloaded)
  --param <key>=<value>    Set an extra request field. Value is interpreted as a JSON
                           literal when valid (numbers, booleans, arrays, objects);
                           otherwise treated as a plain string. Repeatable.
  -H, --headers            Print request/response headers

Environment:
  ORANGE_LLM_BASE_URL      Base URL. Default: http://localhost:8080
  ORANGE_LLM_SHOW_HEADERS  Set to 1 to print headers (or --headers)

Models (examples):
  dall-e-2               OpenAI DALL-E 2 (url response, per-image pricing)
  dall-e-3               OpenAI DALL-E 3 (url response, per-image pricing)
  gpt-image-1            OpenAI GPT Image 1 (b64_json, token pricing)
  gemini-2.5-flash-image Gemini 2.5 Flash image generation (b64_json)

Examples:
  ./images
  ./images "a sunset over the ocean"
  ./images --model gpt-image-1 "a robot reading a book"
  ./images --model dall-e-3 --quality hd --size 1792x1024 "a mountain landscape"
  ./images --model gemini-2.5-flash-image "a cartoon cat"
  ./images --model gpt-image-1 --save /tmp "a neon city at night"
  ./images --model dall-e-2 --n 2 "a red apple"
  ./images --model gpt-image-1 --output /tmp/out.png "a neon city at night"
  ./images --model dall-e-3 --output /tmp/landscape.png "a mountain landscape"
  ./images --model dall-e-3 --param style=vivid "a stormy sea"
  ./images --model gpt-image-1 --param background=transparent --param output_compression=80 "a logo"
  ./images --model gpt-image-1 --param output_format=webp "a robot"
  ./images models
EOF
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 127
  fi
}

parse_args() {
  local positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model)
        MODEL="$2"; shift 2 ;;
      --size)
        SIZE="$2"; shift 2 ;;
      --quality)
        QUALITY="$2"; shift 2 ;;
      --n)
        N="$2"; shift 2 ;;
      --response-format)
        RESPONSE_FORMAT="$2"; shift 2 ;;
      --save)
        # Optional directory argument: --save or --save /tmp
        if [[ $# -gt 1 && "${2:-}" != -* ]]; then
          SAVE_DIR="$2"; shift 2
        else
          SAVE_DIR="."; shift
        fi
        ;;
      --output)
        OUTPUT_FILE="$2"; shift 2 ;;
      --param)
        EXTRA_PARAMS+=("$2"); shift 2 ;;
      -H|--headers)
        SHOW_HEADERS=1; shift ;;
      -h|--help|help)
        usage; exit 0 ;;
      --)
        shift; positional+=("$@"); break ;;
      -*)
        echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
      *)
        positional+=("$1"); shift ;;
    esac
  done
  CMD="${positional[0]:-generate}"
  if [[ "${#positional[@]}" -gt 1 ]]; then
    PROMPT="${positional[1]}"
  elif [[ "${#positional[@]}" -eq 1 && "$CMD" != "models" ]]; then
    PROMPT="$CMD"
    CMD="generate"
  fi
}

tmpdir="$(mktemp -d)"
cleanup() { rm -rf "$tmpdir"; }
trap cleanup EXIT

print_request_headers() {
  [[ "$SHOW_HEADERS" == "1" ]] || return 0
  echo "--- request ---" >&2
  echo "> POST ${BASE_URL}/v1/images/generations" >&2
  echo "> content-type: application/json" >&2
  echo "---------------" >&2
}

print_response_headers() {
  [[ "$SHOW_HEADERS" == "1" ]] || return 0
  local file="$1"
  echo "--- response --" >&2
  while IFS= read -r line; do
    printf '< %s\n' "$line" >&2
  done < "$file"
  echo "---------------" >&2
}

build_payload() {
  require_cmd jq
  local args=(--arg model "$MODEL" --arg prompt "$PROMPT" --argjson n "$N")
  local filter='{model:$model, prompt:$prompt, n:$n}'

  if [[ -n "$SIZE" ]]; then
    args+=(--arg size "$SIZE")
    filter="$filter | .size = \$size"
  fi
  if [[ -n "$QUALITY" ]]; then
    args+=(--arg quality "$QUALITY")
    filter="$filter | .quality = \$quality"
  fi
  if [[ -n "$RESPONSE_FORMAT" ]]; then
    args+=(--arg response_format "$RESPONSE_FORMAT")
    filter="$filter | .response_format = \$response_format"
  fi

  local payload
  payload="$(jq -nc "${args[@]}" "$filter")"

  # Apply --param key=value overrides. Values that are valid JSON literals
  # (numbers, booleans, arrays, objects) are injected as-is; anything else
  # is treated as a plain string.
  for kv in "${EXTRA_PARAMS[@]+"${EXTRA_PARAMS[@]}"}"; do
    local key val
    key="${kv%%=*}"
    val="${kv#*=}"
    if echo "$val" | jq -e . >/dev/null 2>&1; then
      payload="$(echo "$payload" | jq --argjson v "$val" --arg k "$key" '.[$k] = $v')"
    else
      payload="$(echo "$payload" | jq --arg v "$val" --arg k "$key" '.[$k] = $v')"
    fi
  done

  echo "$payload"
}

do_generate() {
  require_cmd jq
  local url="${BASE_URL}/v1/images/generations"
  local payload
  payload="$(build_payload)"
  local headers="$tmpdir/headers"
  local body="$tmpdir/body"

  print_request_headers
  local code
  code="$(curl -sS -H 'content-type: application/json' \
    --data-binary "$payload" \
    -D "$headers" -o "$body" -w '%{http_code}' "$url")"
  print_response_headers "$headers"

  if [[ "$code" == "404" || "$code" == "503" ]]; then
    echo "HTTP $code from $url" >&2
    echo "Orange route may not be wired yet." >&2
    cat "$body"
    echo
    exit 1
  fi

  if [[ "$code" != "200" ]]; then
    jq . "$body" 2>/dev/null || cat "$body"
    echo
    exit 1
  fi

  # Detect response shape and handle accordingly.
  local has_url has_b64
  has_url="$(jq -r '.data[0].url // empty' "$body" 2>/dev/null || true)"
  has_b64="$(jq -r '.data[0].b64_json // empty' "$body" 2>/dev/null | head -c 4 || true)"

  if [[ -n "$has_url" ]]; then
    local count
    count="$(jq '.data | length' "$body")"
    if [[ -n "$OUTPUT_FILE" ]]; then
      # Download URL(s) straight to file(s).
      local i=0
      while [[ $i -lt $count ]]; do
        local out
        if [[ $count -eq 1 ]]; then out="$OUTPUT_FILE"
        else out="${OUTPUT_FILE%.*}_$((i+1)).${OUTPUT_FILE##*.}"; fi
        local url_val
        url_val="$(jq -r ".data[$i].url" "$body")"
        curl -sS -L -o "$out" "$url_val"
        echo "saved: $out" >&2
        i=$((i+1))
      done
    else
      # URL mode: print each URL.
      jq -r '.data[].url' "$body"
    fi
    echo "image_count: $count" >&2
  elif [[ -n "$has_b64" ]]; then
    local count
    count="$(jq '.data | length' "$body")"
    if [[ -n "$OUTPUT_FILE" ]]; then
      # Decode b64_json directly to file(s).
      local i=0
      while [[ $i -lt $count ]]; do
        local out
        if [[ $count -eq 1 ]]; then out="$OUTPUT_FILE"
        else out="${OUTPUT_FILE%.*}_$((i+1)).${OUTPUT_FILE##*.}"; fi
        jq -r ".data[$i].b64_json" "$body" | base64 --decode > "$out"
        echo "saved: $out" >&2
        i=$((i+1))
      done
    elif [[ -n "$SAVE_DIR" ]]; then
      # Save each image to a numbered file.
      mkdir -p "$SAVE_DIR"
      local i=0
      while [[ $i -lt $count ]]; do
        local out="${SAVE_DIR}/image_$((i+1)).png"
        jq -r ".data[$i].b64_json" "$body" | base64 --decode > "$out"
        echo "saved: $out" >&2
        i=$((i+1))
      done
    else
      # No --save/--output: print truncated b64 preview and advise.
      echo "(b64_json response — use --output <file> or --save <dir> to write PNG files)" >&2
      local i=0
      while [[ $i -lt $count ]]; do
        local preview
        preview="$(jq -r ".data[$i].b64_json" "$body" | head -c 64)"
        echo "data[$i]: ${preview}..." >&2
        i=$((i+1))
      done
    fi
    echo "image_count: $count" >&2
  else
    # Unknown shape — dump raw JSON.
    jq . "$body" 2>/dev/null || cat "$body"
    echo
  fi

  # Emit token usage summary when available (gpt-image-1).
  local input_tokens output_tokens image_tokens
  input_tokens="$(jq -r '.usage.input_tokens // empty' "$body" 2>/dev/null || true)"
  output_tokens="$(jq -r '.usage.output_tokens // empty' "$body" 2>/dev/null || true)"
  image_tokens="$(jq -r '.usage.input_tokens_details.image_tokens // empty' "$body" 2>/dev/null || true)"
  if [[ -n "$input_tokens" ]]; then
    local summary="input_tokens: $input_tokens  output_tokens: ${output_tokens:-0}"
    if [[ -n "$image_tokens" && "$image_tokens" != "0" ]]; then
      summary="$summary  image_input_tokens: $image_tokens"
    fi
    echo "$summary" >&2
  fi

  # Echo size/quality from response when present (gpt-image-1).
  local resp_size resp_quality
  resp_size="$(jq -r '.size // empty' "$body" 2>/dev/null || true)"
  resp_quality="$(jq -r '.quality // empty' "$body" 2>/dev/null || true)"
  local meta=""
  [[ -n "$resp_size" ]]    && meta="${meta}size: $resp_size  "
  [[ -n "$resp_quality" ]] && meta="${meta}quality: $resp_quality"
  [[ -n "$meta" ]] && echo "$meta" >&2
}

do_models() {
  local url="${BASE_URL}/v1/models"
  if [[ "$SHOW_HEADERS" == "1" ]]; then
    echo "--- request ---" >&2
    echo "> GET $url" >&2
    echo "---------------" >&2
  fi
  local headers="$tmpdir/headers"
  local body="$tmpdir/body"
  local code
  code="$(curl -sS -D "$headers" -o "$body" -w '%{http_code}' "$url")"
  print_response_headers "$headers"
  if [[ "$code" == 404 || "$code" == 503 ]]; then
    echo "HTTP $code from $url" >&2
    echo "Orange route may not be wired yet." >&2
  fi
  # Filter to image-tagged models if jq is available.
  if command -v jq >/dev/null 2>&1; then
    jq '[.data[] | select(.metadata.tags[]? == "images")]' "$body" 2>/dev/null || cat "$body"
  else
    cat "$body"
  fi
  echo
}

parse_args "$@"
require_cmd curl

case "$CMD" in
  generate) do_generate ;;
  models)   do_models ;;
  *)
    echo "unknown command: $CMD" >&2
    usage >&2
    exit 2
    ;;
esac
