#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${ORANGE_MCP_BASE_URL:-http://localhost:8080/mcp}"
SESSION_ID="${ORANGE_MCP_SESSION_ID:-}"
PROFILE=""
SERVER=""
HAS_TARGET=0
SHOW_HEADERS="${ORANGE_MCP_SHOW_HEADERS:-0}"

usage() {
  cat <<'EOF'
Usage:
  ./mcp [--headers] profile=<name>
  ./mcp [--headers] server=<name>
  ./mcp [--headers] profile=<name> initialize
  ./mcp [--headers] server=<name> initialize
  ./mcp profile=<name> list
  ./mcp server=<name> list
  ./mcp profile=<name> call <backend__tool> <json-args>
  ./mcp server=<name> call <server__tool> <json-args>
  ./mcp profile=<name> stream
  ./mcp server=<name> stream
  ./mcp profile=<name> delete

Environment:
  ORANGE_MCP_BASE_URL      MCP base endpoint. Default: http://localhost:8080/mcp
  ORANGE_MCP_SESSION_ID    Existing public mcp-session-id for list/call/stream/delete
  ORANGE_MCP_SHOW_HEADERS  Set to 1 to print request and response headers (or use --headers)

Examples:
  ./mcp profile=default
  ./mcp server=github
  ./mcp profile=default initialize
  ./mcp server=github initialize
  ORANGE_MCP_SESSION_ID=<printed-session> ./mcp profile=default list
  ORANGE_MCP_SESSION_ID=<printed-session> ./mcp server=github list
  ORANGE_MCP_SESSION_ID=<printed-session> ./mcp profile=default call kiwi__search-flight '{"flyFrom":"SFO","flyTo":"JFK","departureDate":"15/07/2025"}'
  ORANGE_MCP_SESSION_ID=<printed-session> ./mcp server=github call github__get_me '{}'
  ORANGE_MCP_SESSION_ID=<printed-session> ./mcp server=github call github__search_repositories '{"query":"envoy dynamic modules"}'
  ORANGE_MCP_SESSION_ID=<printed-session> ./mcp server=github call github__get_file_contents '{"owner":"envoyproxy","repo":"envoy","path":"README.md"}'
  ORANGE_MCP_SESSION_ID=<printed-session> ./mcp profile=default stream
  ORANGE_MCP_SESSION_ID=<printed-session> ./mcp profile=default delete

Notes:
  This targets the Envoy-facing MCP route. It expects the Orange MCP Envoy
  wiring to exist: inbound /mcp -> orange-mcp sidecar -> Envoy MCP egress.
EOF
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "missing required command: $1" >&2
    exit 127
  fi
}

parse_profile_arg() {
  PARSED_ARGS=()
  local kept=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      --headers)
        SHOW_HEADERS=1
        ;;
      profile=*)
        if [[ -n "$SERVER" ]]; then
          echo "profile= and server= are mutually exclusive" >&2
          exit 2
        fi
        PROFILE="${arg#profile=}"
        HAS_TARGET=1
        ;;
      server=*)
        if [[ -n "$PROFILE" ]]; then
          echo "profile= and server= are mutually exclusive" >&2
          exit 2
        fi
        SERVER="${arg#server=}"
        HAS_TARGET=1
        ;;
      *)
        kept+=("$arg")
        ;;
    esac
  done
  PARSED_ARGS=("${kept[@]}")
}

target_path() {
  if [[ -n "$SERVER" ]]; then
    echo "s/$SERVER"
    return
  fi
  if [[ -n "$PROFILE" ]]; then
    echo "$PROFILE"
    return
  fi
}

request_url() {
  local path
  path="$(target_path)"
  if [[ -z "$path" ]]; then
    echo "$BASE_URL"
    return
  fi
  echo "${BASE_URL%/}/$path"
}

rpc_initialize='{
  "jsonrpc": "2.0",
  "id": "orange-mcp-demo-init",
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-06-18",
    "capabilities": {},
    "clientInfo": {"name": "orange-mcp-demo", "version": "0.1.0"}
  }
}'

rpc_list='{"jsonrpc":"2.0","id":"orange-mcp-demo-list","method":"tools/list","params":{}}'

tmpdir="$(mktemp -d)"
cleanup() {
  rm -rf "$tmpdir"
}
trap cleanup EXIT

extract_session_id() {
  awk 'tolower($1) == "mcp-session-id:" {sub(/\r$/, "", $2); print $2; exit}' "$1"
}

print_request_headers() {
  [[ "$SHOW_HEADERS" == "1" ]] || return 0
  local method="${1:-POST}"
  local url
  url="$(request_url)"
  echo "--- request headers ---" >&2
  echo "> $method $url" >&2
  [[ "$method" == "POST" ]] && echo "> content-type: application/json" >&2
  [[ -n "$SESSION_ID" ]] && echo "> mcp-session-id: $SESSION_ID" >&2
  echo "-----------------------" >&2
}

print_response_headers() {
  [[ "$SHOW_HEADERS" == "1" ]] || return 0
  local file="$1"
  echo "--- response headers --" >&2
  while IFS= read -r line; do
    printf '< %s\n' "$line" >&2
  done < "$file"
  echo "-----------------------" >&2
}

print_response_or_hint() {
  local code="$1"
  local body="$2"
  if [[ "$code" == 404 || "$code" == 503 ]]; then
    echo "HTTP $code from $(request_url)" >&2
    echo "Orange MCP Envoy route/listener may not be wired yet." >&2
  fi
  cat "$body"
}

post_rpc() {
  local payload="$1"
  local headers="$tmpdir/headers"
  local body="$tmpdir/body"
  local args=(
    -sS
    -D "$headers"
    -o "$body"
    -w '%{http_code}'
    -X POST "$(request_url)"
    -H 'content-type: application/json'
    --data-binary "$payload"
  )
  if [[ -n "$SESSION_ID" ]]; then
    args+=(-H "mcp-session-id: $SESSION_ID")
  fi
  print_request_headers POST
  local code
  code="$(curl "${args[@]}")"
  print_response_headers "$headers"
  print_response_or_hint "$code" "$body"
  echo
  if [[ "$code" =~ ^2 ]]; then
    local new_session
    new_session="$(extract_session_id "$headers")"
    if [[ -n "$new_session" ]]; then
      echo >&2
      echo "export ORANGE_MCP_SESSION_ID='$new_session'" >&2
    fi
  else
    return 1
  fi
}

initialize() {
  SESSION_ID=""
  post_rpc "$rpc_initialize"
}

list_tools() {
  if [[ -z "$SESSION_ID" ]]; then
    echo "ORANGE_MCP_SESSION_ID is required; run ./mcp initialize first" >&2
    exit 2
  fi
  post_rpc "$rpc_list"
}

call_tool() {
  require_cmd jq
  if [[ -z "$SESSION_ID" ]]; then
    echo "ORANGE_MCP_SESSION_ID is required; run ./mcp initialize first" >&2
    exit 2
  fi
  local tool="${1:-}"
  local arguments="${2:-}"
  [[ -z "$arguments" ]] && arguments='{}'
  if [[ -z "$tool" ]]; then
    echo "call requires <backend__tool>" >&2
    usage >&2
    exit 2
  fi
  local payload
  payload="$(jq -nc --arg tool "$tool" --argjson arguments "$arguments" \
    '{jsonrpc:"2.0", id:"orange-mcp-demo-call", method:"tools/call", params:{name:$tool, arguments:$arguments}}')"
  post_rpc "$payload"
}

stream_events() {
  if [[ -z "$SESSION_ID" ]]; then
    echo "ORANGE_MCP_SESSION_ID is required; run ./mcp initialize first" >&2
    exit 2
  fi
  local resp_headers="$tmpdir/stream-headers"
  local dump_args=()
  [[ "$SHOW_HEADERS" == "1" ]] && dump_args=(-D "$resp_headers")
  print_request_headers GET
  curl -N -sS "${dump_args[@]}" "$(request_url)" \
    -H "mcp-session-id: $SESSION_ID"
  [[ "$SHOW_HEADERS" == "1" ]] && print_response_headers "$resp_headers"
}

delete_session() {
  if [[ -z "$SESSION_ID" ]]; then
    echo "ORANGE_MCP_SESSION_ID is required; run ./mcp initialize first" >&2
    exit 2
  fi
  local resp_headers="$tmpdir/delete-headers"
  local dump_args=()
  [[ "$SHOW_HEADERS" == "1" ]] && dump_args=(-D "$resp_headers")
  print_request_headers DELETE
  curl -sS -X DELETE "${dump_args[@]}" "$(request_url)" \
    -H "mcp-session-id: $SESSION_ID"
  echo
  [[ "$SHOW_HEADERS" == "1" ]] && print_response_headers "$resp_headers"
}

parse_profile_arg "$@"
set -- "${PARSED_ARGS[@]}"
if [[ $# -eq 0 && "$HAS_TARGET" -eq 1 ]]; then
  cmd="initialize"
else
  cmd="${1:-all}"
  shift || true
fi

require_cmd curl

case "$cmd" in
  initialize) initialize ;;
  list) list_tools ;;
  call) call_tool "$@" ;;
  stream) stream_events ;;
  delete) delete_session ;;
  all)
    initialize
    echo
    echo "Run the printed export command, then:"
    echo "  ./mcp list"
    echo "  ./mcp call kiwi__search-flight '{\"flyFrom\":\"SFO\",\"flyTo\":\"JFK\",\"departureDate\":\"15/07/2025\"}'"
    echo
    echo "GitHub examples (server=github, requires GITHUB_TOKEN):"
    echo "  ./mcp server=github call github__get_me '{}'"
    echo "  ./mcp server=github call github__search_repositories '{\"query\":\"envoy dynamic modules\"}'"
    echo "  ./mcp server=github call github__get_file_contents '{\"owner\":\"envoyproxy\",\"repo\":\"envoy\",\"path\":\"README.md\"}'"
    ;;
  -h|--help|help) usage ;;
  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
