#!/usr/bin/env bash
set -euo pipefail

# demos/claude — run Claude Code CLI against Orange.
#
# Orange serves the Anthropic Messages API at /v1/messages and routes
# requests to the configured Anthropic (or Vertex Anthropic) backend
# based on the model field in the body.
#
# Orange accepts API keys in either Authorization header (Bearer token) or
# x-api-key header. Set ANTHROPIC_API_KEY to the Orange key ID.

ORANGE_BASE_URL="${ORANGE_CLAUDE_BASE_URL:-http://localhost:8080}"
MODEL="${ORANGE_CLAUDE_MODEL:-claude-haiku-4-5}"
ORANGE_API_KEY="${ORANGE_API_KEY:-demo/dio/sk-default}"

export ANTHROPIC_BASE_URL="$ORANGE_BASE_URL"
export ANTHROPIC_API_KEY="$ORANGE_API_KEY"

exec claude \
  --bare \
  --model "$MODEL" \
  "$@"
